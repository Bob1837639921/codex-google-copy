{
  "manifest_version": 3,
  "name": "NodeX Browser Agent",
  "version": "1.0",
  "description": "🧠 基于高速 WebSocket 与 CDP 内核的无脚本、纯内存 AI 浏览器实时控制桥梁（支持可见标签组与微光标拟人轨迹）。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NodeX Browser Agent",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}